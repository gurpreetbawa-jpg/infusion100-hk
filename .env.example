# Server
PORT=3000
SESSION_SECRET=your_random_secret_here

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/infusion100

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/callback/google

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/auth/callback/github

# Strava OAuth
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_CALLBACK_URL=http://localhost:3000/auth/callback/strava

# Strava Webhook
STRAVA_WEBHOOK_VERIFY_TOKEN=

# Encryption (for Strava token storage)
ENCRYPTION_KEY=your_32_char_random_key_here

# Admin emails (comma-separated)
ADMIN_EMAILS=

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
